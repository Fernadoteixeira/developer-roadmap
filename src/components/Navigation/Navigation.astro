---
import { AccountStreak } from '../AccountStreak/AccountStreak';
import Icon from '../AstroIcon.astro';
import { NavigationDropdown } from '../NavigationDropdown';
import { RoadmapDropdownMenu } from '../RoadmapDropdownMenu/RoadmapDropdownMenu';
import { AccountDropdown } from './AccountDropdown';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import {
  createTranslator,
  defaultLocale,
  getLocalizedPath,
} from '../../i18n';

const locale = Astro.locals.locale || defaultLocale;
const t = createTranslator(locale);
const href = (path: string) => getLocalizedPath(path, locale);
---

<div class='bg-slate-900 py-5 text-white sm:py-8'>
  <nav class='container flex items-center justify-between'>
    <div class='flex items-center gap-5'>
      <a
        class='flex items-center text-lg font-medium text-white'
        href={href('/')}
        aria-label='roadmap.sh'
      >
        <Icon icon='logo' />
      </a>

      <a
        href={href('/ai')}
        class='group relative inline text-gray-400 hover:text-white sm:hidden'
      >
        {t('nav.aiTutor')}
      </a>

      <div class='hidden gap-5 sm:flex sm:items-center'>
        <NavigationDropdown client:load />
        <a href={href('/get-started')} class='text-gray-400 hover:text-white'>
          {t('nav.startHere')}
        </a>
        <RoadmapDropdownMenu client:load />
        <a
          href={href('/ai')}
          class='group relative mr-3 text-blue-300 hover:text-white'
        >
          {t('nav.aiTutor')}
          <span class='absolute top-0 -right-[11px]'>
            <span class='relative flex h-2 w-2'>
              <span
                class='absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-400 opacity-75'
              ></span>
              <span class='relative inline-flex h-2 w-2 rounded-full bg-sky-500'
              ></span>
            </span>
          </span>
        </a>
        <a
          href={href('/teams')}
          class='group relative hidden text-gray-400 hover:text-white xl:block'
        >
          {t('nav.teams')}
        </a>
        <LanguageSwitcher />
      </div>
    </div>

    <ul class='hidden h-8 w-[172px] items-center justify-end gap-5 sm:flex'>
      <li data-guest-required class='hidden'>
        <a href={href('/login')} class='text-gray-400 hover:text-white'>
          {t('nav.login')}
        </a>
      </li>
      <li class='flex items-center gap-2'>
        <AccountStreak client:only='react' />
        <AccountDropdown client:only='react' />

        <a
          data-guest-required
          class='flex hidden h-8 w-28 cursor-pointer items-center justify-center rounded-full bg-linear-to-r from-blue-500 to-blue-700 px-4 py-2 text-sm font-medium text-white hover:from-blue-500 hover:to-blue-600'
          href={href('/signup')}
        >
          <span>{t('nav.signUp')}</span>
        </a>
      </li>
    </ul>

    <button
      class='block cursor-pointer text-gray-400 hover:text-gray-50 sm:hidden'
      aria-label={t('nav.menu')}
      data-show-mobile-nav
    >
      <Icon icon='hamburger' />
    </button>

    <div
      class='fixed top-0 right-0 bottom-0 left-0 z-40 flex hidden items-center bg-slate-900'
      data-mobile-nav
    >
      <button
        data-close-mobile-nav
        class='absolute top-6 right-6 block cursor-pointer text-gray-400 hover:text-gray-50'
        aria-label={t('nav.closeMenu')}
      >
        <Icon icon='close' />
      </button>
      <ul class='flex w-full flex-col items-center gap-2 md:gap-3'>
        <li>
          <a href={href('/roadmaps')} class='text-xl hover:text-blue-300 md:text-lg'>
            {t('nav.roadmaps')}
          </a>
        </li>
        <li>
          <a
            href={href('/best-practices')}
            class='text-xl hover:text-blue-300 md:text-lg'
          >
            {t('nav.bestPractices')}
          </a>
        </li>
        <li>
          <a href={href('/guides')} class='text-xl hover:text-blue-300 md:text-lg'>
            {t('nav.guides')}
          </a>
        </li>
        <li>
          <a href={href('/videos')} class='text-xl hover:text-blue-300 md:text-lg'>
            {t('nav.videos')}
          </a>
        </li>

        <li data-auth-required class='hidden'>
          <a href={href('/account')} class='text-xl hover:text-blue-300 md:text-lg'>
            {t('nav.account')}
          </a>
        </li>
        <li data-auth-required class='hidden'>
          <a href={href('/team')} class='text-xl hover:text-blue-300 md:text-lg'>
            {t('nav.teams')}
          </a>
        </li>
        <li data-auth-required class='hidden'>
          <button
            data-logout-button
            class='text-xl text-red-300 hover:text-red-400 md:text-lg'
          >
            {t('nav.logout')}
          </button>
        </li>
        <li>
          <a
            data-guest-required
            href={href('/login')}
            class='hidden text-xl text-white md:text-lg'
          >
            {t('nav.login')}
          </a>
        </li>
        <li>
          <a
            data-guest-required
            href={href('/signup')}
            class='hidden text-xl text-green-300 hover:text-green-400 md:text-lg'
          >
            {t('nav.signUp')}
          </a>
        </li>
        <li><LanguageSwitcher variant='mobile' /></li>
      </ul>
    </div>
  </nav>
</div>

<script src='./navigation.ts'></script>
