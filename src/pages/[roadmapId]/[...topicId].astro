---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import MarkdownIt from 'markdown-it-async';
import { fileURLToPath } from 'node:url';
import { defaultLocale } from '../../i18n';
import { localeFileSuffixes } from '../../i18n/config';

export const prerender = false;

const { topicId, roadmapId } = Astro.params;
const locale = Astro.locals.locale || defaultLocale;

if (!topicId || !roadmapId) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not found';
  return Astro.rewrite('/404');
}

const topicPath = Array.isArray(topicId) ? topicId.join('/') : topicId;
const pathSegments = topicPath.split('/');

if (
  pathSegments.some(
    (segment) =>
      !segment || segment === '.' || segment === '..' || segment.includes('\\'),
  )
) {
  Astro.response.status = 400;
  Astro.response.statusText = 'Invalid topic path';
  return new Response('Invalid topic path', { status: 400 });
}

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const projectRoot = path.resolve(__dirname, '../../..').replace(/dist$/, '');
const contentRoot = path.resolve(
  projectRoot,
  'src',
  'data',
  'roadmaps',
  roadmapId,
  'content',
);
const localeSuffix = localeFileSuffixes[locale];
const localizedCandidates = localeSuffix
  ? [
      `${topicPath}.${localeSuffix}.md`,
      path.join(topicPath, `index.${localeSuffix}.md`),
    ]
  : [];
const candidates = [
  ...localizedCandidates,
  `${topicPath}.md`,
  path.join(topicPath, 'index.md'),
];
const contentPath = candidates
  .map((candidate) => path.resolve(contentRoot, candidate))
  .find(
    (candidatePath) =>
      candidatePath.startsWith(`${contentRoot}${path.sep}`) &&
      fs.existsSync(candidatePath),
  );

if (!contentPath) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not found';
  return Astro.rewrite('/404');
}

const fileContent = fs.readFileSync(contentPath, 'utf-8');
const { content } = matter(fileContent);
const fileWithoutBasePath = contentPath.replace(/.+?\/src\/data/, '/src/data');
const gitHubUrl = `https://github.com/kamranahmedse/developer-roadmap/tree/master${fileWithoutBasePath}`;
const md = MarkdownIt();
const htmlContent = await md.renderAsync(content);
---

<div data-github-url={gitHubUrl}></div>
<Fragment set:html={htmlContent} />
